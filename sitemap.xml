<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%}
  Generated from site.pages and site.posts. Do not hand-add <url> blocks: every
  previous attempt duplicated an entry the loop already emitted (see 7351e9f and
  the three dupes removed in db66680). A new page is picked up automatically.

  lastmod comes from each page's `last_modified_at` front matter, NOT site.time.
  site.time is the build timestamp, so every page claimed to change on every
  deploy and Google learned to discount the field entirely.

  Excluded: noindex pages (privacy, terms), the 404, and the /go/ /r/ /s/
  redirect shims, which are all noindex or not canonical destinations.

  site.pages also holds generated assets (the leftover theme's
  assets/css/style.css, feed.xml, robots.txt). Those are filtered by requiring
  a trailing slash: with `permalink: pretty` every real page is /like-this/ or
  bare "/", and nothing else is. The old extension blacklist missed .css and
  put a 76KB stylesheet in the sitemap as an indexable page.
{%- endcomment -%}
{%- assign excluded = "/privacy/,/terms/,/404.html,/go/,/r/,/s/" | split: "," -%}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{%- for page in site.pages -%}
{%- assign last_char = page.url | slice: -1 -%}
{%- unless last_char != "/" or excluded contains page.url or page.robots contains "noindex" %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ page.url }}</loc>
    <lastmod>{{ page.last_modified_at | default: page.date | default: site.time | date_to_xmlschema }}</lastmod>
    <changefreq>{% if page.url == "/" %}weekly{% else %}monthly{% endif %}</changefreq>
    <priority>{% if page.url == "/" %}1.0{% elsif page.product_page %}0.9{% else %}0.8{% endif %}</priority>
  </url>
{%- endunless -%}
{%- endfor -%}
{%- for post in site.posts %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ post.url }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
{%- endfor %}
  <url>
    <loc>https://arcassistant.app/2026/09/21/ai-screen-assistant-windows/</loc>
    <lastmod>2026-09-21T00:00:00+00:00</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
    <url>
    <loc>https://arcassistant.app/2026/09/22/ai-assistant-for-iphone/</loc>
    <lastmod>2026-09-22T00:00:00+00:00</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  </urlset>
